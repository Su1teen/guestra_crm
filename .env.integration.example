# Optional Railway runtime configuration. Keep OFF until manual schema review and consumer rollout.
CRM_PMS_INTEGRATION_ENABLED=false
GUESTRA_SANDBOX_SETUP_ENABLED=false
INTEGRATION_ENVIRONMENT=production
# Server-only hashed principals; generate keyHash from an independent random key.
CRM_INTEGRATION_PRINCIPALS=[]
# Base URL includes /api/v1/connect. HTTPS required outside loopback test.
PMS_CONNECT_URL=https://pms.example.com/api/v1/connect
# PMS_CONNECT_KEY=
# PMS_COMMAND_SECRET=
# PMS_EVENT_SECRET=
PMS_PROPERTY_MAPPINGS=[]
# [{"crmPropertyId":"...","crmTenantId":"...","pmsPropertyId":"UUID","pmsTenantId":"...","environment":"production"}]
# MEDIA_REFERENCE_SECRET=
MEDIA_ALLOWED_ORIGINS=[]
# Principal example:
# [{"id":"n8n-sandbox","keyHash":"64-lowercase-hex-sha256","environment":"sandbox","propertyIds":["CRM_PROPERTY"],"scopes":["agent.read","agent.write","integration.read","integration.write","tool:get_context","tool:create_or_update_request","tool:create_offer","tool:book_accommodation"],"workspaceIds":["STUDIO_WORKSPACE"]}]
# Use a separate PMS Inbox principal with integration.read,inbox.read,inbox.handoff.
# Retain existing .env.example login/session/outbound variables.
