DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guestra_crm
SESSION_SECRET=replace-with-at-least-32-random-characters
CRM_INTEGRATION_API_KEY=replace-with-a-long-random-integration-key
# Optional n8n inbound webhook for Telegram delivery from the Guestra Inbox.
AGENT_OUTBOUND_WEBHOOK_URL=
# Separate secret for Guestra → n8n delivery callbacks; never reuse the inbound API key.
AGENT_OUTBOUND_WEBHOOK_TOKEN=
SALES_BOOTSTRAP_EMAIL=sales@guestra.com
SALES_BOOTSTRAP_PASSWORD=replace-with-a-strong-sales-password
ADMIN_BOOTSTRAP_EMAIL=admin@guestra.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
PORT=3000
NODE_ENV=production
